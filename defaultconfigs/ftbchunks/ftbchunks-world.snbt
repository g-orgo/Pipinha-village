# Default config file that will be copied to saves/Solito solamente/serverconfig/ftbchunks-world.snbt if it doesn't exist!
# Just copy any values you wish to override in here!

{
	# Society: Sunlit Valley: no claim or force load limit (2026-11-11). 1000000000 instead of the int max
	# because FTB Chunks adds the team's extra_*_chunks on top and a bigger value would overflow.
	max_claimed_chunks: 1000000000
	max_force_loaded_chunks: 1000000000
}
