{
  "multipart": [
    {
      "apply": {
        "model": "society:block/kubejs/juice_inserter_particle"
      }
    },
    {
      "when": {
        "facing": "north"
      },
      "apply": {
        "model": "society:block/kubejs/juice_inserter",
        "y": 0,
        "uvlock": false
      }
    },
    {
      "when": {
        "facing": "east"
      },
      "apply": {
        "model": "society:block/kubejs/juice_inserter",
        "y": 90,
        "uvlock": false
      }
    },
    {
      "when": {
        "facing": "south"
      },
      "apply": {
        "model": "society:block/kubejs/juice_inserter",
        "y": 180,
        "uvlock": false
      }
    },
    {
      "when": {
        "facing": "west"
      },
      "apply": {
        "model": "society:block/kubejs/juice_inserter",
        "y": -90,
        "uvlock": false
      }
    }
  ]
}
